{
  "name": "shesterenka-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/make-images.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir ../dist-ssr && node scripts/prerender.mjs",
    "check": "node scripts/check.mjs",
    "preview": "vite preview",
    "fonts": "node scripts/make-fonts.mjs",
    "phone": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "publish": "npm run build && npm run check && node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "vite": "^8.3.2"
  }
}
